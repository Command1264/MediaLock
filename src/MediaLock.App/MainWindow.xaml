<Window x:Class="MediaLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Lock"
        Width="840"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Continue">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Media Lock" />
            <TextBlock Margin="0,8,0,0"
                       AutomationProperties.Name="Routing status"
                       Text="{Binding RoutingStatus, StringFormat=Status: {0}}" />
            <TextBlock Margin="0,4,0,0"
                       AutomationProperties.Name="Current media target"
                       Text="{Binding TargetDescription}" />
            <Border Margin="0,12,0,0" Padding="12" Background="#FFFFE5E5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock AutomationProperties.Name="Media Lock error"
                           Foreground="#FF8B0000"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Media Sessions" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="8,0,0,0"
                        Padding="14,7"
                        AutomationProperties.Name="Lock selected Media Session"
                        Command="{Binding LockCommand}"
                        Content="Lock selected" />
                <Button Margin="8,0,0,0"
                        Padding="14,7"
                        AutomationProperties.Name="Use Windows automatic media target"
                        Command="{Binding WindowsAutoCommand}"
                        Content="Windows Auto" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <ListBox AutomationProperties.Name="Available Media Sessions"
                     ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding SelectedSession}"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding SourceApplication}" />
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#FF666666" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding PlaybackStatus}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="No Media Sessions"
                       FontSize="16"
                       Foreground="#FF666666"
                       Text="{Binding EmptyStateText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <UniformGrid Grid.Row="3" Margin="0,18,0,0" Columns="6">
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="Previous" Command="{Binding PreviousCommand}" Content="Previous" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="Play" Command="{Binding PlayCommand}" Content="Play" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="Pause" Command="{Binding PauseCommand}" Content="Pause" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="Toggle play pause" Command="{Binding TogglePlayPauseCommand}" Content="Play/Pause" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="Next" Command="{Binding NextCommand}" Content="Next" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="Stop" Command="{Binding StopCommand}" Content="Stop" />
        </UniformGrid>
    </Grid>
</Window>
