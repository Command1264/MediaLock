<Window x:Class="MediaLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MediaLock.App.Localization"
        Title="Media Lock" Width="920" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" KeyboardNavigation.TabNavigation="Continue"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="28,24,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Media Lock" />
                <TextBlock Margin="1,5,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="{loc:Translate Main_Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Margin="0,0,10,0" VerticalAlignment="Center"
                        Style="{StaticResource StatusPillStyle}">
                    <TextBlock AutomationProperties.Name="{loc:Translate Main_RoutingStatus}"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding RoutingStatusLine}" />
                </Border>
                <Button MinWidth="104" AutomationProperties.Name="{loc:Translate Main_OpenSettings}"
                        Command="{Binding SettingsCommand}" Content="{loc:Translate Main_Settings}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="88" Height="88" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe UI Symbol" FontSize="30"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="&#xE8D6;" />
                        <Image AutomationProperties.Name="{loc:Translate Main_Artwork}"
                               Source="{Binding NowPlayingArtwork, Converter={StaticResource MediaArtworkImageConverter}}"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,88,88" RadiusX="8" RadiusY="8" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   Text="{loc:Translate Main_CurrentTarget}" />
                        <TextBlock Margin="0,4,0,0" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20" FontWeight="SemiBold" Text="{Binding TargetDescription}"
                                   ToolTip="{Binding CurrentTargetSourceDetails}"
                                   AutomationProperties.HelpText="{Binding CurrentTargetSourceDetails}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding NowPlayingArtist}" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding HasNowPlayingTimeline, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                  PreviewMouseLeftButtonDown="OnPlaybackSeekPointerDown"
                                  PreviewMouseMove="OnPlaybackSeekPointerMove"
                                  PreviewMouseLeftButtonUp="OnPlaybackSeekPointerUp"
                                  LostMouseCapture="OnPlaybackSeekMouseCaptureLost"
                                  PreviewTouchDown="OnPlaybackSeekTouchDown"
                                  PreviewTouchMove="OnPlaybackSeekTouchMove"
                                  PreviewTouchUp="OnPlaybackSeekTouchUp"
                                  LostTouchCapture="OnPlaybackSeekTouchCaptureLost">
                                <Slider x:Name="PlaybackSeekSlider"
                                        Minimum="0" Maximum="{Binding NowPlayingDurationSeconds}"
                                        Value="{Binding NowPlayingPositionSeconds, Mode=OneWay}"
                                        SmallChange="5" LargeChange="15" IsMoveToPointEnabled="True"
                                        IsEnabled="{Binding CanSeek}"
                                        AutomationProperties.Name="{loc:Translate Main_PlaybackSeek}"
                                        ToolTip="{loc:Translate Main_PlaybackSeekHelp}"
                                        ValueChanged="OnPlaybackSeekValueChanged"
                                        PreviewKeyDown="OnPlaybackSeekKeyDown"
                                        PreviewKeyUp="OnPlaybackSeekKeyUp"
                                        LostKeyboardFocus="OnPlaybackSeekLostKeyboardFocus" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                           FontSize="11" Text="{Binding NowPlayingElapsed}" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}"
                                           FontSize="11" Text="{Binding NowPlayingDuration}" />
                            </Grid>
                        </Grid>
                        <Grid x:Name="PlaybackStateLockPanel" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PlaybackStateLockLabel"
                                       VerticalAlignment="Center"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{loc:Translate Main_PlaybackStateLock}" />
                            <WrapPanel Grid.Column="1" Margin="6,0,0,0"
                                       HorizontalAlignment="Left">
                                <ToggleButton x:Name="PlaybackStateLockOffButton"
                                              Margin="8,0,0,0"
                                              Style="{StaticResource StateLockToggleStyle}"
                                              AutomationProperties.Name="{loc:Translate Main_PlaybackStateLockOffAutomation}"
                                              Command="{Binding PlaybackStateLockOffCommand}"
                                              Content="{loc:Translate Main_PlaybackStateLockOff}"
                                              IsChecked="{Binding IsPlaybackStateLockOff, Mode=OneWay}" />
                                <ToggleButton x:Name="PlaybackStateLockKeepPlayingButton"
                                              Margin="8,0,0,0"
                                              Style="{StaticResource StateLockToggleStyle}"
                                              AutomationProperties.Name="{loc:Translate Main_KeepPlayingAutomation}"
                                              Command="{Binding KeepPlayingCommand}"
                                              Content="{loc:Translate Main_KeepPlaying}"
                                              IsChecked="{Binding IsKeepPlaying, Mode=OneWay}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                       Margin="0,6,0,0" Text="{Binding PlaybackStateLockNotice}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="{Binding HasPlaybackStateLockNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaybackStateLockFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ErrorCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               AutomationProperties.Name="{loc:Translate Main_Error}"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Margin="12,0,0,0" MinWidth="28" MinHeight="28"
                            Padding="4,0" VerticalAlignment="Center"
                            Style="{StaticResource CompactButtonStyle}" Content="&#x00D7;"
                            Foreground="{DynamicResource DangerBrush}"
                            Command="{Binding DismissErrorCommand}"
                            AutomationProperties.Name="{loc:Translate Main_DismissError}"
                            ToolTip="{loc:Translate Main_DismissError}" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,2,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}"
                       Text="{loc:Translate Main_MediaSources}" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <ToggleButton Margin="8,0,0,0"
                              Style="{StaticResource RoutingModeToggleStyle}"
                              IsChecked="{Binding IsSessionLockMode, Mode=OneWay}"
                              AutomationProperties.Name="{loc:Translate Main_LockSessionAutomation}"
                              Command="{Binding LockCommand}"
                              Content="{loc:Translate Main_LockSession}" />
                <ToggleButton Margin="8,0,0,0"
                              Style="{StaticResource RoutingModeToggleStyle}"
                              IsChecked="{Binding IsAppLockMode, Mode=OneWay}"
                              AutomationProperties.Name="{loc:Translate Main_LockAppAutomation}"
                              Command="{Binding AppLockCommand}"
                              Content="{loc:Translate Main_LockApp}" />
                <ToggleButton Margin="8,0,0,0"
                              Style="{StaticResource RoutingModeToggleStyle}"
                              IsChecked="{Binding IsPriorityRulesMode, Mode=OneWay}"
                              AutomationProperties.Name="{loc:Translate Main_PriorityRulesAutomation}"
                              Command="{Binding PriorityRulesCommand}"
                              Content="{loc:Translate Mode_PriorityRules}" />
                <ToggleButton Margin="8,0,0,0"
                              Style="{StaticResource RoutingModeToggleStyle}"
                              IsChecked="{Binding IsWindowsAutoMode, Mode=OneWay}"
                              AutomationProperties.Name="{loc:Translate Main_WindowsAutoAutomation}"
                              Command="{Binding WindowsAutoCommand}"
                              Content="{loc:Translate Mode_WindowsAuto}" />
            </WrapPanel>
        </Grid>

        <ScrollViewer x:Name="MediaSourceScrollViewer" Grid.Row="3"
                      AutomationProperties.Name="{loc:Translate Main_AvailableMediaSources}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True" Focusable="False">
            <ItemsControl Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding MediaSourceGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="12" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Width="36" Height="36" Margin="0,0,8,0"
                                            Command="{Binding DataContext.ToggleMediaSourceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Translate Main_ToggleMediaSourceGroup}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                                                <Setter Property="Content" Value="&#x25B6;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Content" Value="&#x25BC;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ToggleButton Grid.Column="1" HorizontalContentAlignment="Left"
                                                  Style="{StaticResource RoutingModeToggleStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding DataContext.SelectMediaSourceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  AutomationProperties.Name="{Binding DisplayName}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </ToggleButton>
                                </Grid>

                                <StackPanel Margin="44,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Visibility="{Binding HasBrowserTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{loc:Translate Main_BrowserPageTargets}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{loc:Translate Main_BrowserPageTargetsHelp}" />
                                        </StackPanel>
                                        <ListBox Margin="0,0,0,10"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 PreviewMouseWheel="OnNestedMediaSourcePreviewMouseWheel"
                                                 AutomationProperties.Name="{loc:Translate Main_AvailableBrowserTargets}"
                                                 ItemsSource="{Binding BrowserTargets}"
                                                 SelectedItem="{Binding DataContext.SelectedBrowserTarget, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 KeyboardNavigation.DirectionalNavigation="Contained">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MediaPlaybackStatus" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceDisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                                       Text="{Binding TargetDetails}"
                                                                       ToolTip="{Binding TargetDetails}"
                                                                       AutomationProperties.HelpText="{Binding TargetDetails}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="18,0">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                                       Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Width="36" Height="36"
                                                                Style="{StaticResource OverflowButtonStyle}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Click="OnBrowserTargetActionsClick"
                                                                Content="&#x2026;"
                                                                AutomationProperties.Name="{loc:Translate Main_BrowserTargetActions}">
                                                            <Button.ContextMenu>
                                                                <ContextMenu Style="{StaticResource BrowserTargetContextMenuStyle}">
                                                                    <MenuItem Style="{StaticResource BrowserTargetMenuItemStyle}"
                                                                              Header="{loc:Translate Main_RevokeBrowserAuthorization}"
                                                                              AutomationProperties.Name="{loc:Translate Main_RevokeBrowserAuthorizationAutomation}"
                                                                              Command="{Binding PlacementTarget.Tag.RevokeBrowserTargetAuthorizationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                        <Border Grid.Column="3"
                                                                Style="{StaticResource MediaPlaybackStatusPillStyle}">
                                                            <TextBlock Style="{StaticResource MediaPlaybackStatusTextStyle}"
                                                                       Text="{Binding PlaybackStatus}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                                   Text="{loc:Translate Main_WindowsMediaSessions}" />
                                        <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 PreviewMouseWheel="OnNestedMediaSourcePreviewMouseWheel"
                                                 AutomationProperties.Name="{loc:Translate Main_AvailableSessions}"
                                                 ItemsSource="{Binding Sessions}"
                                                 SelectedItem="{Binding DataContext.SelectedSession, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 KeyboardNavigation.DirectionalNavigation="Contained">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MediaPlaybackStatus" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Text="{Binding SourceApplicationDisplayName}"
                                                                   ToolTip="{Binding SourceApplicationDetails}"
                                                                   AutomationProperties.HelpText="{Binding SourceApplicationDetails}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}"
                                                                       Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border Grid.Column="3"
                                                                Style="{StaticResource MediaPlaybackStatusPillStyle}">
                                                            <TextBlock Style="{StaticResource MediaPlaybackStatusTextStyle}"
                                                                       Text="{Binding PlaybackStatus}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Background="{DynamicResource LayerBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMediaSourceGroups}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28"
                       AutomationProperties.Name="{loc:Translate Main_NoSessions}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15"
                       Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <UniformGrid Columns="6">
                <Button Margin="0,0,6,0" AutomationProperties.Name="{loc:Translate Command_Previous}" Command="{Binding PreviousCommand}" Content="{loc:Translate Command_Previous}" />
                <Button Margin="6,0" AutomationProperties.Name="{loc:Translate Command_Play}" Command="{Binding PlayCommand}" Content="{loc:Translate Command_Play}" />
                <Button Margin="6,0" AutomationProperties.Name="{loc:Translate Command_Pause}" Command="{Binding PauseCommand}" Content="{loc:Translate Command_Pause}" />
                <Button Margin="6,0" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="{loc:Translate Command_ToggleAutomation}" Command="{Binding TogglePlayPauseCommand}" Content="{loc:Translate Command_Toggle}" />
                <Button Margin="6,0" AutomationProperties.Name="{loc:Translate Command_Next}" Command="{Binding NextCommand}" Content="{loc:Translate Command_Next}" />
                <Button Margin="6,0,2,0" AutomationProperties.Name="{loc:Translate Command_Stop}" Command="{Binding StopCommand}" Content="{loc:Translate Command_Stop}" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
