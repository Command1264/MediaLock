<Window x:Class="MediaLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MediaLock.App.Localization"
        Title="Media Lock"
        Width="840"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Continue">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Media Lock" />
                <TextBlock Margin="0,8,0,0"
                           AutomationProperties.Name="{loc:Translate Main_RoutingStatus}"
                           Text="{Binding RoutingStatusLine}" />
                <TextBlock Margin="0,4,0,0"
                           AutomationProperties.Name="{loc:Translate Main_CurrentTarget}"
                           Text="{Binding TargetDescription}" />
            </StackPanel>
            <Button Grid.Row="0" Grid.Column="1"
                    MinWidth="104"
                    Margin="16,0,0,0"
                    Padding="12,7"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{loc:Translate Main_OpenSettings}"
                    Command="{Binding SettingsCommand}"
                    Content="{loc:Translate Main_Settings}" />
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,12,0,0" Padding="12" Background="#FFFFE5E5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock AutomationProperties.Name="{loc:Translate Main_Error}"
                           Foreground="#FF8B0000"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
            </Border>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{loc:Translate Main_MediaSessions}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="8,0,0,0"
                        Padding="14,7"
                        AutomationProperties.Name="{loc:Translate Main_LockSessionAutomation}"
                        Command="{Binding LockCommand}"
                        Content="{loc:Translate Main_LockSession}" />
                <Button Margin="8,0,0,0"
                        Padding="14,7"
                        AutomationProperties.Name="{loc:Translate Main_LockAppAutomation}"
                        Command="{Binding AppLockCommand}"
                        Content="{loc:Translate Main_LockApp}" />
                <Button Margin="8,0,0,0"
                        Padding="14,7"
                        AutomationProperties.Name="{loc:Translate Main_PriorityRulesAutomation}"
                        Command="{Binding PriorityRulesCommand}"
                        Content="{loc:Translate Mode_PriorityRules}" />
                <Button Margin="8,0,0,0"
                        Padding="14,7"
                        AutomationProperties.Name="{loc:Translate Main_WindowsAutoAutomation}"
                        Command="{Binding WindowsAutoCommand}"
                        Content="{loc:Translate Mode_WindowsAuto}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <ListBox AutomationProperties.Name="{loc:Translate Main_AvailableSessions}"
                     ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding SelectedSession}"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding SourceApplication}" />
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#FF666666" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding PlaybackStatus}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="{loc:Translate Main_NoSessions}"
                       FontSize="16"
                       Foreground="#FF666666"
                       Text="{Binding EmptyStateText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <UniformGrid Grid.Row="3" Margin="0,18,0,0" Columns="6">
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="{loc:Translate Command_Previous}" Command="{Binding PreviousCommand}" Content="{loc:Translate Command_Previous}" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="{loc:Translate Command_Play}" Command="{Binding PlayCommand}" Content="{loc:Translate Command_Play}" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="{loc:Translate Command_Pause}" Command="{Binding PauseCommand}" Content="{loc:Translate Command_Pause}" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="{loc:Translate Command_ToggleAutomation}" Command="{Binding TogglePlayPauseCommand}" Content="{loc:Translate Command_Toggle}" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="{loc:Translate Command_Next}" Command="{Binding NextCommand}" Content="{loc:Translate Command_Next}" />
            <Button Margin="4" Padding="10,8" AutomationProperties.Name="{loc:Translate Command_Stop}" Command="{Binding StopCommand}" Content="{loc:Translate Command_Stop}" />
        </UniformGrid>
    </Grid>
</Window>
