<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="MediaLockThemeMarker">Dark</sys:String>

    <SolidColorBrush x:Key="WindowBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="LayerBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="LayerAltBrush" Color="#FF323232" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#FF454545" />
    <SolidColorBrush x:Key="BorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC7C7C7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF76D7FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF45B8E8" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF10232C" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF18384B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#FF233A25" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FF433A13" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FF442726" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF60CDFF" />
    <Color x:Key="OverflowGlyphShadowColor">#D0000000</Color>
</ResourceDictionary>
