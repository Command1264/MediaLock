<Window x:Class="MediaLock.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MediaLock.App.Localization"
        Title="{loc:Translate Settings_WindowTitle}"
        Width="620"
        Height="700"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Continue">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{loc:Translate Settings_Title}" />
            <TextBlock Margin="0,6,0,0" Foreground="#FF666666"
                       Text="{loc:Translate Settings_Description}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <GroupBox Header="{loc:Translate Settings_General}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox Margin="0,0,0,10"
                              AutomationProperties.Name="{loc:Translate Settings_CloseToTrayAutomation}"
                              IsChecked="{Binding CloseToTray}"
                              Content="{loc:Translate Settings_CloseToTray}" />
                    <CheckBox Margin="0,0,0,14"
                              AutomationProperties.Name="{loc:Translate Settings_StartWithWindowsAutomation}"
                              IsChecked="{Binding StartWithWindows}"
                              Content="{loc:Translate Settings_StartWithWindows}" />
                    <TextBlock Margin="0,0,0,6" Text="{loc:Translate Settings_Language}" />
                    <ComboBox AutomationProperties.Name="{loc:Translate Settings_LanguageAutomation}"
                              ItemsSource="{Binding Languages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedLanguage}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FF666666"
                               Text="{loc:Translate Settings_LanguageApply}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Translate Settings_RoutingRecovery}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12"
                               VerticalAlignment="Center" Text="{loc:Translate Settings_StartupMode}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="{loc:Translate Settings_StartupMode}"
                               Text="{Binding StartupRoutingModeText}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12"
                               VerticalAlignment="Center" Text="{loc:Translate Settings_RecoveryTimeout}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                             AutomationProperties.Name="{loc:Translate Settings_RecoveryTimeoutAutomation}"
                             Text="{Binding RecoveryTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,0"
                               VerticalAlignment="Center" Text="{loc:Translate Settings_FallbackPolicy}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              AutomationProperties.Name="{loc:Translate Settings_FallbackPolicy}"
                              ItemsSource="{Binding FallbackPolicies}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding FallbackPolicy}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,12,0,0"
                               Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{loc:Translate Settings_RoutingHelp}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{loc:Translate Settings_PriorityRules}" Padding="14">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10"
                               Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{loc:Translate Settings_PriorityRulesHelp}" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6"
                                AutomationProperties.Name="{loc:Translate Settings_AddRuleAutomation}"
                                Command="{Binding AddPriorityRuleCommand}"
                                Content="{loc:Translate Settings_Add}" />
                        <ComboBox AutomationProperties.Name="{loc:Translate Settings_AvailableAppsAutomation}"
                                  ItemsSource="{Binding AvailableApplications}"
                                  SelectedItem="{Binding SelectedAvailableApplication}"
                                  MinWidth="280" />
                    </DockPanel>
                    <ItemsControl AutomationProperties.Name="{loc:Translate Settings_RulesAutomation}"
                                  ItemsSource="{Binding PriorityRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{loc:Translate Settings_EnableRuleAutomation}"
                                              IsChecked="{Binding IsEnabled}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding SourceAppUserModelId}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Margin="8,0,0,0" Padding="9,4"
                                            AutomationProperties.Name="{loc:Translate Settings_MoveRuleUpAutomation}"
                                            Command="{Binding DataContext.MovePriorityRuleUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="↑" />
                                    <Button Grid.Column="3" Margin="4,0,0,0" Padding="9,4"
                                            AutomationProperties.Name="{loc:Translate Settings_MoveRuleDownAutomation}"
                                            Command="{Binding DataContext.MovePriorityRuleDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="↓" />
                                    <Button Grid.Column="4" Margin="4,0,0,0" Padding="9,4"
                                            AutomationProperties.Name="{loc:Translate Settings_RemoveRuleAutomation}"
                                            Command="{Binding DataContext.RemovePriorityRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{loc:Translate Settings_Remove}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"
                       AutomationProperties.Name="{loc:Translate Settings_ErrorAutomation}"
                       Foreground="#FF8B0000"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}" />
            <Button Grid.Column="1" HorizontalAlignment="Right" Padding="18,8"
                    AutomationProperties.Name="{loc:Translate Settings_SaveAutomation}"
                    Command="{Binding SaveCommand}"
                    Content="{loc:Translate Settings_Save}" />
        </Grid>
    </Grid>
</Window>
