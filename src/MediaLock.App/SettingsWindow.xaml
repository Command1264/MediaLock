<Window x:Class="MediaLock.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MediaLock.App.Localization"
        Title="{loc:Translate Settings_WindowTitle}" Width="680" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" KeyboardNavigation.TabNavigation="Continue"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Margin="12" Padding="1"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#FF000000" Opacity="0.28" ShadowDepth="0" />
        </Border.Effect>
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{loc:Translate Settings_Title}" />
            <TextBlock Margin="1,5,0,0" Style="{StaticResource SecondaryTextStyle}"
                       Text="{loc:Translate Settings_Description}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionTitleStyle}"
                                   Text="{loc:Translate Settings_General}" />
                        <CheckBox Margin="0,0,0,12" AutomationProperties.Name="{loc:Translate Settings_CloseToTrayAutomation}"
                                  IsChecked="{Binding CloseToTray}" Content="{loc:Translate Settings_CloseToTray}" />
                        <CheckBox Margin="0,0,0,12" AutomationProperties.Name="{loc:Translate Settings_StartWithWindowsAutomation}"
                                  IsChecked="{Binding StartWithWindows}" Content="{loc:Translate Settings_StartWithWindows}" />
                        <CheckBox AutomationProperties.Name="{loc:Translate Settings_InterceptMediaKeysAutomation}"
                                  IsChecked="{Binding InterceptMediaKeys}" Content="{loc:Translate Settings_InterceptMediaKeys}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionTitleStyle}"
                                   Text="{loc:Translate Settings_Appearance}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,12,12" VerticalAlignment="Center" Text="{loc:Translate Settings_Language}" />
                            <ComboBox Grid.Column="1" Margin="0,0,0,12" AutomationProperties.Name="{loc:Translate Settings_LanguageAutomation}"
                                      ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedLanguageOption}" />
                            <TextBlock Grid.Row="1" Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Translate Settings_Theme}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{loc:Translate Settings_ThemeAutomation}"
                                      ItemsSource="{Binding Themes}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedThemeOption}" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"
                                   Text="{loc:Translate Settings_ThemeApply}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionTitleStyle}"
                                   Text="{loc:Translate Settings_RoutingRecovery}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,12,12" VerticalAlignment="Center" Text="{loc:Translate Settings_StartupMode}" />
                            <TextBlock Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" FontWeight="SemiBold"
                                       AutomationProperties.Name="{loc:Translate Settings_StartupMode}" Text="{Binding StartupRoutingModeText}" />
                            <TextBlock Grid.Row="1" Margin="0,0,12,12" VerticalAlignment="Center" Text="{loc:Translate Settings_RecoveryTimeout}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" AutomationProperties.Name="{loc:Translate Settings_RecoveryTimeoutAutomation}"
                                     Text="{Binding RecoveryTimeoutText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Grid.Row="2" Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Translate Settings_FallbackPolicy}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" AutomationProperties.Name="{loc:Translate Settings_FallbackPolicy}"
                                      ItemsSource="{Binding FallbackPolicies}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                      SelectedValue="{Binding FallbackPolicy}" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="{loc:Translate Settings_RoutingHelp}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitleStyle}" Text="{loc:Translate Settings_PriorityRules}" />
                        <TextBlock Margin="0,0,0,12" Style="{StaticResource SecondaryTextStyle}" Text="{loc:Translate Settings_PriorityRulesHelp}" TextWrapping="Wrap" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="{loc:Translate Settings_AddRuleAutomation}" Command="{Binding AddPriorityRuleCommand}" Content="{loc:Translate Settings_Add}" />
                            <ComboBox MinWidth="280" AutomationProperties.Name="{loc:Translate Settings_AvailableAppsAutomation}"
                                      ItemsSource="{Binding AvailableApplications}" SelectedItem="{Binding SelectedAvailableApplication}" />
                        </DockPanel>
                        <ItemsControl AutomationProperties.Name="{loc:Translate Settings_RulesAutomation}" ItemsSource="{Binding PriorityRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="10" Background="{DynamicResource LayerAltBrush}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="{loc:Translate Settings_EnableRuleAutomation}" IsChecked="{Binding IsEnabled}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding SourceAppUserModelId}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource CompactButtonStyle}" AutomationProperties.Name="{loc:Translate Settings_MoveRuleUpAutomation}" Command="{Binding DataContext.MovePriorityRuleUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="↑" />
                                            <Button Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource CompactButtonStyle}" AutomationProperties.Name="{loc:Translate Settings_MoveRuleDownAutomation}" Command="{Binding DataContext.MovePriorityRuleDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="↓" />
                                            <Button Grid.Column="4" Margin="4,0,0,0" Style="{StaticResource CompactButtonStyle}" AutomationProperties.Name="{loc:Translate Settings_RemoveRuleAutomation}" Command="{Binding DataContext.RemovePriorityRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{loc:Translate Settings_Remove}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitleStyle}"
                                   Text="{loc:Translate Settings_AboutDiagnostics}" />
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource SecondaryTextStyle}"
                                   Text="{loc:Translate Settings_AboutDescription}" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,12,8" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Translate Settings_Version}" />
                            <TextBlock Grid.Column="1" Margin="0,0,0,8" FontWeight="SemiBold"
                                       Text="{Binding AppVersion}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Margin="0,0,12,8" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Translate Settings_Windows}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                       Text="{Binding WindowsDescription}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Translate Settings_ReleaseStatus}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding ReleaseStatusText}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource SecondaryTextStyle}"
                                   Text="{loc:Translate Settings_DiagnosticsPrivacy}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button MinWidth="132" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Translate Settings_CopyDiagnosticsAutomation}"
                                    Command="{Binding CopyDiagnosticsCommand}"
                                    Content="{loc:Translate Settings_CopyDiagnostics}" />
                            <Button MinWidth="120" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Translate Settings_OpenLogsAutomation}"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    Content="{loc:Translate Settings_OpenLogs}" />
                            <Button MinWidth="112" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Translate Settings_OpenSupportAutomation}"
                                    Command="{Binding OpenSupportCommand}"
                                    Content="{loc:Translate Settings_OpenSupport}" />
                            <Button MinWidth="112" Margin="0,0,0,8" Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="{loc:Translate Settings_ReportBugAutomation}"
                                    Command="{Binding ReportBugCommand}"
                                    Content="{loc:Translate Settings_ReportBug}" />
                        </WrapPanel>
                        <TextBlock Foreground="{DynamicResource SuccessBrush}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding SupportStatusMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="{loc:Translate Settings_ErrorAutomation}"
                       Foreground="{DynamicResource DangerBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <Button Grid.Column="1" MinWidth="112" AutomationProperties.Name="{loc:Translate Settings_CancelAutomation}"
                    Command="{Binding CancelCommand}" Content="{loc:Translate Settings_Cancel}" />
            <Button Grid.Column="2" MinWidth="132" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="{loc:Translate Settings_SaveAutomation}" Command="{Binding SaveCommand}" Content="{loc:Translate Settings_Save}" />
        </Grid>
    </Grid>
    </Border>
</Window>
