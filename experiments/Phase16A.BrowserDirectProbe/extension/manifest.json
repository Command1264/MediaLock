{
  "manifest_version": 3,
  "name": "Media Lock Phase 16A Browser Direct Probe",
  "version": "0.0.1",
  "description": "Disposable direct-control probe for explicitly authorized YouTube targets.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Media Lock Phase 16A Probe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
