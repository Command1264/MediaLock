{
  "manifest_version": 3,
  "name": "Media Lock Phase 16B Generic Web Media Probe",
  "version": "0.0.3",
  "description": "Disposable direct-control probe for fixed sites and user-authorized generic web media.",
  "key": "",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Media Lock Phase 16B Probe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "media-policy.js",
        "content-script.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
